{
  "name": "dsh-custom-next",
  "version": "0.1.6",
  "private": true,
  "files": [
    "icon.svg",
    "justfile",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@morlay/better-session": "workspace:*",
    "@morlay/dsh-desktopify": "workspace:*",
    "@morlay/dsh-preset": "workspace:*",
    "@morlay/dsh-agent-preset": "workspace:*"
  },
  "peerDependencies": {
    "tsx": "*"
  },
  "dsh": {
    "version": "workspace:*",
    "profile": {
      "bundles": [
        "@morlay/better-session",
        "@morlay/dsh-preset",
        "@morlay/dsh-agent-preset"
      ]
    },
    "dev": {
      "web": {
        "clientBundles": {
          "prefixes": [
            "@morlay/"
          ]
        }
      }
    },
    "desktop": {
      "id": "ai.deepseek.dsh.custom-next",
      "window": {
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      },
      "icon": "icon.svg",
      "dshHome": "xdg"
    }
  }
}
