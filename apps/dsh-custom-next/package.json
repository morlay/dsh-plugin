{
  "name": "dsh-custom-next",
  "version": "0.2.1",
  "private": true,
  "files": [
    "icon.svg"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@morlay/zephyr": "workspace:*",
    "@morlay/zephyr-app": "workspace:*",
    "@morlay/zephyr-ui": "workspace:*",
    "@morlay/dsh-agent": "workspace:*",
    "@morlay/dsh-auth": "workspace:*",
    "@morlay/dsh-context": "workspace:*",
    "@morlay/dsh-env": "workspace:*",
    "@morlay/dsh-permission": "workspace:*",
    "@morlay/dsh-session": "workspace:*",
    "@morlay/dsh-setting": "workspace:*",
    "@morlay/dsh-storage": "workspace:*",
    "@morlay/dsh-task": "workspace:*",
    "@morlay/dsh-telemetry": "workspace:*",
    "@morlay/dsh-tool-web": "workspace:*",
    "@morlay/dsh-deepseek-feedback": "workspace:*"
  },
  "peerDependencies": {
    "@local/dshdev": "workspace:*"
  },
  "dsh": {
    "version": "workspace:*",
    "desktop": {
      "id": "ai.deepseek.dsh.custom-next",
      "name": "DSH Custom Next",
      "icon": "icon.svg",
      "window": {
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      },
      "dataDir": "xdg"
    },
    "dev": {
      "exclude": [
        "@deepseek-ai/*"
      ]
    }
  },
  "scripts": {
    "web": "node --import @oxc-node/core/register src/main.ts"
  }
}
