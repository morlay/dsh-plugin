{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "node"],
  "ignorePatterns": ["target/**", "lib/**", "**/dist/**", "**/src/vendor/**"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "node/no-sync": "error"
  },
  "overrides": [
    {
      "files": ["**/src/__tests__/schema-fixture.ts"],
      "rules": {
        "typescript/no-implied-eval": "off"
      }
    }
  ]
}
