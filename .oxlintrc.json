{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "node"
  ],
  "ignorePatterns": [
    "target/**",
    "lib/**",
    "**/dist/**",
    "**/src/vendor/**",
    "_packages/**"
  ],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "node/no-sync": "error"
  }
}
