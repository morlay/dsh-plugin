{
  "extends": ["@local/devkit/tsconfig.json"],
  // 跨项目 import 不重写相对扩展名（上游两片 aggregate 同样关着它）：开了就报 TS2878。
  "compilerOptions": {
    "rewriteRelativeImportExtensions": false,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": ".tmp/tsc-client"
  },
  "references": [{ "path": "./tsconfig.host.json" }],
  "include": [
    "packages/*/*/src/client/**/*",
    "vendor/**/src/client/**/*",
    // `*/remote` 的生成态（`typert.remote-client.ts`）在 `lib/` 里：client 侧的 remote 装配直接引用它。
    "vendor/**/lib/**/*",
    "packages/*/*/src/css-modules.d.ts"
  ],
  "exclude": ["**/node_modules/**", "**/dist/*"]
}
