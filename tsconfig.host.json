{
  "extends": ["@local/devkit/tsconfig.json"],
  "compilerOptions": {
    "paths": {
      "@morlay/dsh-base/*": ["./packages/bundles/dsh-base/src/*/index.ts"]
    },
    "rewriteRelativeImportExtensions": false,
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "include": ["**/*"],
  "files": [
    "vendor/deepseek-harness/packages/core/agent-loop/tests/mock-adapter.ts",
    "vendor/deepseek-harness/packages/subagent/subagent/tests/working-directory-fixture.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/*",
    "**/lib/*",
    "**/src/client/**",
    "vendor/**/*.config.ts",
    "vendor/**/tests/**",
    "vendor/steps.ts",
    // 上游 apps 是它自己的应用面（本仓库只用 apps/cli 当 install anchor），按我们的 TS 口径过不了；
    // 声明生成（`target/dts`）压根不含它。文档站那类整块没用的已经由 patch 的 `rm` 步骤裁掉。
    "vendor/**/apps/**",
    "target/**",
    "vendor/**/apps/**",
    "**/website/**",
    "vendor/**/vitest.shared.ts"
  ]
}
