+/**
+ * Copy one payload about to enter the log, giving the log strings of its own.
+ *
+ * {@link snapshotJsonValue} copies the structure but keeps string values as they are, so a
+ * string sliced out of a large buffer — a truncated tool result, a joined stream, a cut
+ * prompt — keeps that whole buffer alive for as long as the log lives. A structured clone
+ * rebuilds every string, releasing the parent the event no longer needs. The cost is one
+ * extra pass over the payload per append, paid to keep long sessions bounded.
+ * @param value - payload about to enter the log.
+ * @param subject - what is being recorded, for the rejection message.
+ * @returns the detached snapshot whose strings own their bytes.
+ * @throws {Error} when the payload is not losslessly JSON-serializable.
+ */
+function snapshotLogPayload<T>(value: T, subject: string): T {
+  const snapshot = snapshotJsonValue(value)
+  if (snapshot === undefined) throw new Error(`${subject} carries non-JSON-serializable data`)
+  return structuredClone(snapshot)
+}
