+/**
+ * Whether two projected list states are observationally identical: same order,
+ * same row identities, same phase and projection map.
+ * @param previous - published state.
+ * @param next - freshly derived state.
+ * @returns whether publishing `next` would change nothing.
+ */
+function sameListState(previous: SessionListState, next: SessionListState): boolean {
+  if (previous.phase !== next.phase) return false
+  if (previous.projectionsBySession !== next.projectionsBySession) return false
+  if (previous.ids.length !== next.ids.length) return false
+  for (const [index, id] of next.ids.entries()) {
+    if (previous.ids[index] !== id) return false
+    if (previous.byId[id] !== next.byId[id]) return false
+  }
+  return true
+}
