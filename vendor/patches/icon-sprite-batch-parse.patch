+/**
+ * Parse one batch of icons through a single document parse. Parsing each icon
+ * as its own SVG document paid the XML parser's per-document setup once per
+ * symbol (~60 in the default set, measured as tens of milliseconds in one long
+ * task); one wrapper document amortizes it over the whole set. The glyph source
+ * is always a single `<svg>` root, so its attributes move onto the symbol and
+ * its children become the symbol's content, exactly as the per-icon path did.
+ * @param entries - symbol id and SVG source pairs.
+ * @returns imported symbol elements, in `entries` order.
+ */
+function toSymbols(entries: readonly (readonly [string, string])[]): SVGSymbolElement[] {
+  const markup = `<svg xmlns="${SVG_NS}">${entries.map(([id, source]) => {
+    const open = source.indexOf('>')
+    const close = source.lastIndexOf('</svg>')
+    const attributes = source.slice('<svg'.length, open)
+    const body = source.slice(open + 1, close < 0 ? source.length : close)
+    return `<symbol id="${id}"${attributes}>${body}</symbol>`
+  }).join('')}</svg>`
+  const parsed = new DOMParser().parseFromString(markup, 'image/svg+xml')
+  return [...parsed.querySelectorAll('symbol')].map((node) => {
+    const symbol = document.importNode(node, true) as SVGSymbolElement
+    for (const name of DROPPED_ATTRIBUTES) symbol.removeAttribute(name)
+    return symbol
+  })
 }
 
