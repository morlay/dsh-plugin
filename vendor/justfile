# 三个脚本都是 TS，用随仓库的 oxc loader 直跑（`@local/devkit/ts-loader`）；不依赖 tsx：它没被任何
# 清单声明过，`node_modules/.bin/tsx` 只是别家依赖顺带提升上来的。
loader := join(module_directory(), '../devpackages/devkit/src/ts-loader.mjs')
skill := join(module_directory(), '../.agents/skills/dsh-plugin-upstream-sync/scripts')

sync:
    node --import={{ loader }} {{ skill }}/sync.ts

patch:
    node --import={{ loader }} {{ skill }}/patch.ts

build:
    node --import={{ loader }} {{ skill }}/build.ts

prepare: sync patch build
