upstream-sync-source := join(module_directory(), '../scripts/upstream-sync')

_deps:
    @cd {{ upstream-sync-source }} && pnpm install --reporter=silent

sync: _deps
    pnx --package={{ upstream-sync-source }} upstream-sync sync

patch: _deps
    pnx --package={{ upstream-sync-source }} upstream-sync patch

prebuild: _deps
    pnx --package={{ upstream-sync-source }} upstream-sync prebuild
