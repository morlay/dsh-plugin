# 同步链是 `devpackages/upstream-sync` 这个包（做成包是为了它能声明自己的依赖，比如 AST 探查用的解析器），
# 一律用 `pnpm dlx @oxc-node/cli` 直跑它的 CLI（oxc transformer + resolver）；
# 不用 tsx（没被任何清单声明过），也不写 `node --import=…`。
cli := join(module_directory(), '../devpackages/upstream-sync/src/cli.ts')

sync:
    pnpm dlx @oxc-node/cli {{ cli }} sync

patch:
    pnpm dlx @oxc-node/cli {{ cli }} patch

prebuild:
    pnpm dlx @oxc-node/cli {{ cli }} prebuild
