{
  "name": "@morlay/dsh-web-search-ollama",
  "version": "0.0.2",
  "description": "Ollama-backed search provider for the DeepSeek Harness web seam (ctx.web): one web_search backend calling POST https://ollama.com/api/web_search.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ollama",
    "web-search"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "locale/*.json",
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./rows": "./src/rows.ts",
    "./package.json": "./package.json",
    "./client": "./src/client/index.ts",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./rows": "./dist/rows.mjs",
      "./package.json": "./package.json",
      "./client": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      },
      "./locale/*.json": "./locale/*.json"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "test:e2e": "pnpm exec vitest run --config vitest.e2e.config.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cosmokit": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@morlay/dsh-client-ui-primitives": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cosmokit": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-credentials": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^",
    "@deepseek-ai/dsh-web": "workspace:^",
    "@morlay/dsh-client-ui-primitives": "workspace:*"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@morlay/dsh-client-ui-primitives"
      ]
    }
  }
}
