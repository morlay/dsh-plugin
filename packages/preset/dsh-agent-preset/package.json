{
  "name": "@morlay/dsh-agent-preset",
  "version": "0.0.1-alpha.0",
  "description": "Personal dsh profile bundle: registers the coding / chat agent presets — each with its own isolated injection channel (context assembler) and injection rows, so no other preset is touched.",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "agent-preset",
    "preset"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "dist",
    "src",
    "tool",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./relax-intent": "./src/relax-intent.ts",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./relax-intent": "./dist/relax-intent.mjs",
      "./package.json": "./package.json",
      "./cordis.patch.yml": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@morlay/dsh-context-agent-instructions": "workspace:*",
    "@morlay/dsh-context-assembler": "workspace:*",
    "@morlay/dsh-context-reference": "workspace:*",
    "@morlay/dsh-context-scope": "workspace:*",
    "@morlay/dsh-context-skill-catalog": "workspace:*",
    "@morlay/dsh-context-tool-guidance": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:*",
    "@deepseek-ai/dsh-fs": "workspace:*",
    "@deepseek-ai/dsh-scope": "workspace:*",
    "@deepseek-ai/dsh-command-compact": "workspace:*",
    "@deepseek-ai/dsh-command-goal": "workspace:*",
    "@deepseek-ai/dsh-compaction-basic": "workspace:*",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "workspace:*",
    "@deepseek-ai/dsh-persona": "workspace:*",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:*",
    "@deepseek-ai/dsh-tool-ask-user": "workspace:*",
    "@deepseek-ai/dsh-tool-bash": "workspace:*",
    "@deepseek-ai/dsh-tool-fs": "workspace:*",
    "@deepseek-ai/dsh-tool-fs-search": "workspace:*",
    "@deepseek-ai/dsh-tool-goal": "workspace:*",
    "@deepseek-ai/dsh-tool-jobs": "workspace:*",
    "@deepseek-ai/dsh-tool-present": "workspace:*",
    "@deepseek-ai/dsh-tool-pwsh": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent-control": "workspace:*",
    "@deepseek-ai/dsh-tool-todo": "workspace:*",
    "@deepseek-ai/dsh-tool-web": "workspace:*",
    "@deepseek-ai/dsh-tool-workflow": "workspace:*",
    "@deepseek-ai/dsh-workflow-ptc": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-fs": "workspace:*",
    "@deepseek-ai/dsh-scope": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
