{
  "name": "@morlay/dsh-desktop-shell",
  "version": "0.2.6",
  "description": "Electron shell for dsh desktop apps: serves the app's own <name>:// scheme, boots the desktop profile through the @morlay/dsh-desktop-host child over byte pipes, and installs the profile seed on first launch. The CLI that packages a workspace around it is @local/dshdev.",
  "keywords": [
    "desktop",
    "dsh",
    "electron",
    "shell"
  ],
  "license": "MIT",
  "author": "morlay",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "src",
    "locale/*.json",
    "dist"
  ],
  "type": "module",
  "main": "./main.mjs",
  "exports": {
    ".": "./src/index.ts",
    "./appconfig": "./src/appconfig.ts",
    "./dshhome": "./src/dshhome.ts",
    "./official": "./src/official.ts",
    "./profile-project": "./src/profile-project.ts",
    "./seed": "./src/seed.ts",
    "./inline-packages": "./src/inline-packages.ts",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./appconfig": {
        "types": "./dist/appconfig.d.mts",
        "default": "./dist/appconfig.mjs"
      },
      "./dshhome": {
        "types": "./dist/dshhome.d.mts",
        "default": "./dist/dshhome.mjs"
      },
      "./official": {
        "types": "./dist/official.d.mts",
        "default": "./dist/official.mjs"
      },
      "./profile-project": {
        "types": "./dist/profile-project.d.mts",
        "default": "./dist/profile-project.mjs"
      },
      "./seed": {
        "types": "./dist/seed.d.mts",
        "default": "./dist/seed.mjs"
      },
      "./inline-packages": {
        "types": "./dist/inline-packages.d.mts",
        "default": "./dist/inline-packages.mjs"
      },
      "./package.json": "./package.json",
      "./locale/*.json": "./locale/*.json"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-crypto": "workspace:*",
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "@morlay/dsh-desktop-host": "workspace:*"
  },
  "devDependencies": {
    "@local/devkit": "workspace:*",
    "@oxc-node/core": "^0.1.6",
    "@types/node": "^26.5.0",
    "electron": "44.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-atomic-write": "workspace:^",
    "@deepseek-ai/dsh-client-shortcuts": "workspace:^"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
