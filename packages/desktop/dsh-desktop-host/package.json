{
  "name": "@morlay/dsh-desktop-host",
  "version": "0.0.1-alpha.5",
  "description": "Desktop host process for dsh-desktopify: boots the desktop profile and serves it through an in-process, portless webServer over byte pipes — upstream apps/desktop-host with the web carrier taken over and the Office skill mount removed.",
  "keywords": [
    "desktop",
    "dsh",
    "dsh-plugin",
    "electron",
    "host"
  ],
  "license": "MIT",
  "author": "morlay",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "lib",
    "config/desktop.cordis.patch.yml"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./webserver": {
      "types": "./src/webserver.ts",
      "default": "./lib/webserver.js"
    },
    "./wire": {
      "types": "./src/wire.ts",
      "default": "./lib/wire.js"
    },
    "./patch": {
      "types": "./src/patch.ts",
      "default": "./lib/patch.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:*",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-tool-workspace-dependencies": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-api-gateway": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@types/node": "^26.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
