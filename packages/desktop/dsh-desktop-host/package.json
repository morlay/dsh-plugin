{
  "name": "@morlay/dsh-desktop-host",
  "version": "0.2.6-alpha.0",
  "description": "Desktop host process for dshdev: boots the desktop profile and serves it through an in-process, portless webServer over byte pipes — upstream apps/desktop-host with the web carrier taken over and the Office composition dropped.",
  "keywords": [
    "desktop",
    "dsh",
    "dsh-plugin",
    "electron",
    "host"
  ],
  "license": "MIT",
  "author": "morlay",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "locale/*.json",
    "dist",
    "config/desktop.cordis.patch.yml"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./webserver": "./src/webserver.ts",
    "./wire": "./src/wire.ts",
    "./paths": "./src/paths.ts",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "./webserver": {
        "types": "./dist/webserver.d.mts",
        "default": "./dist/webserver.js"
      },
      "./wire": {
        "types": "./dist/wire.d.mts",
        "default": "./dist/wire.js"
      },
      "./paths": {
        "types": "./dist/paths.d.mts",
        "default": "./dist/paths.js"
      },
      "./package.json": "./package.json",
      "./locale/*.json": "./locale/*.json"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@morlay/dsh-client-modules": "workspace:*",
    "@morlay/web-custom-profile": "workspace:*",
    "lightningcss": "^1.32.0",
    "rolldown": "1.x",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-api-gateway": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@local/devkit": "workspace:*",
    "@types/node": "^26.5.0",
    "@types/ws": "^8.18.2",
    "playwright": "^1.64.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
