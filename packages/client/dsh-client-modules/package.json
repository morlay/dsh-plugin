{
  "name": "@morlay/dsh-client-modules",
  "version": "0.2.9",
  "description": "Dev-form web layer for dsh: serves the page, the app entry and every client resource through an in-process vite dev server (middleware mode) — the node-side counterpart of upstream @deepseek-ai/dsh-client-modules, with the module table replaced by vite's resolver, dependency prebundling and HMR.",
  "keywords": [
    "client",
    "dsh",
    "dsh-plugin",
    "host",
    "vite"
  ],
  "license": "MIT",
  "author": "morlay",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "src",
    "app-boot",
    "dist",
    "locale/*.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./client": "./src/client/index.ts",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json",
      "./client": {
        "types": "./dist/client.d.mts",
        "import": "./dist/client.mjs",
        "default": "./dist/client.cjs"
      },
      "./locale/*.json": "./locale/*.json"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-theme": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@morlay/dsh-cordis-assets": "workspace:*",
    "@oxc-project/runtime": "^0.153.0",
    "lightningcss": "^1.30.0",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@local/devkit": "workspace:*",
    "@types/node": "^26.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "react": "^18.3.1",
    "rolldown": "^1.2.14"
  },
  "engines": {
    "dsh": ">= 0.2.1-rc.1 < 0.2.2",
    "node": ">=24.11.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
