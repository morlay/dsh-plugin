{
  "name": "@morlay/dsh-client-modules",
  "version": "0.2.6-alpha.0",
  "description": "Dev-form web layer for dsh: serves the page, the app entry and every client resource through an in-process vite dev server (middleware mode) — the node-side counterpart of upstream @deepseek-ai/dsh-client-modules, with the module table replaced by vite's resolver, dependency prebundling and HMR.",
  "keywords": [
    "client",
    "dsh",
    "dsh-plugin",
    "host",
    "vite"
  ],
  "license": "MIT",
  "author": "morlay",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "src",
    "app-boot",
    "dist",
    "locale/*.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./assets": "./src/assets.ts",
    "./styles": "./src/styles.ts",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./assets": {
        "types": "./dist/assets.d.mts",
        "default": "./dist/assets.mjs"
      },
      "./styles": {
        "types": "./dist/styles.d.mts",
        "default": "./dist/styles.mjs"
      },
      "./package.json": "./package.json",
      "./locale/*.json": "./locale/*.json"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-theme": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@oxc-project/runtime": "^0.153.0",
    "lightningcss": "^1.30.0",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@local/devkit": "workspace:*",
    "@local/tsdown-plugin-cordis": "workspace:*",
    "@types/node": "^26.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
