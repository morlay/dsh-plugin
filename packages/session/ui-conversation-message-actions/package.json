{
  "name": "@morlay/ui-conversation-message-actions",
  "version": "0.1.6",
  "description": "Rewind / retry / recall / fork orchestration (host) plus the browser half — replaces the conversation.chat.node user / steering rendering and overrides the conversation.composer.dock stats row.",
  "keywords": [
    "conversation-chat-node",
    "dsh",
    "dsh-plugin",
    "edit",
    "fork",
    "message-actions",
    "retry",
    "rewind",
    "ui-conversation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "locale/*.json",
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./plan": "./src/plan.ts",
    "./testing": "./src/testing.ts",
    "./package.json": "./package.json",
    "./client": "./src/client/index.ts",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./plan": {
        "types": "./dist/plan.d.mts",
        "default": "./dist/plan.mjs"
      },
      "./testing": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "./package.json": "./package.json",
      "./client": {
        "types": "./dist/client.d.mts",
        "import": "./dist/client.mjs",
        "default": "./dist/client.mjs"
      },
      "./locale/*.json": "./locale/*.json"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@morlay/session-branch": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-session-stats": "workspace:*",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-api-session-controller": "workspace:^",
    "@deepseek-ai/dsh-attachment": "workspace:^",
    "@deepseek-ai/dsh-client-connection": "workspace:^",
    "@deepseek-ai/dsh-client-store": "workspace:^",
    "@deepseek-ai/dsh-client-ui-attachment": "workspace:^",
    "@deepseek-ai/dsh-client-ui-chat": "workspace:^",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-client-ui-workspace": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-persistence": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "@deepseek-ai/dsh-token-meter": "workspace:^",
    "@morlay/dsh-client-ui-primitives": "workspace:*",
    "@morlay/session-rdb": "workspace:*",
    "react": "^18.2.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
