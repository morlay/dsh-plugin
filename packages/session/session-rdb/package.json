{
  "name": "@morlay/session-rdb",
  "version": "0.1.12",
  "description": "RDB durable session backend for DeepSeek Harness: implements both session-persistence and session-branch (rewind / retry / fork) providers.",
  "keywords": [
    "branch",
    "dsh",
    "dsh-plugin",
    "rdb",
    "rewind",
    "session-persistence",
    "session-rdb"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "locale/*.json",
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./artifact": "./src/artifact.ts",
    "./deletion": "./src/deletion.ts",
    "./export": "./src/export.ts",
    "./organize": "./src/organize.ts",
    "./import": "./src/import.ts",
    "./storage": "./src/storage.ts",
    "./testing": "./src/testing.ts",
    "./usage": "./src/usage.ts",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./artifact": {
        "types": "./dist/artifact.d.mts",
        "default": "./dist/artifact.mjs"
      },
      "./deletion": {
        "types": "./dist/deletion.d.mts",
        "default": "./dist/deletion.mjs"
      },
      "./export": {
        "types": "./dist/export.d.mts",
        "default": "./dist/export.mjs"
      },
      "./organize": {
        "types": "./dist/organize.d.mts",
        "default": "./dist/organize.mjs"
      },
      "./import": {
        "types": "./dist/import.d.mts",
        "default": "./dist/import.mjs"
      },
      "./storage": {
        "types": "./dist/storage.d.mts",
        "default": "./dist/storage.mjs"
      },
      "./testing": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "./usage": {
        "types": "./dist/usage.d.mts",
        "default": "./dist/usage.mjs"
      },
      "./package.json": "./package.json",
      "./locale/*.json": "./locale/*.json"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@morlay/rdbkit": "workspace:*",
    "@morlay/session-branch": "workspace:*",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@deepseek-ai/cosmokit": "workspace:^",
    "@deepseek-ai/dsh-agent-loop-testkit": "workspace:^",
    "@deepseek-ai/dsh-compaction": "workspace:^",
    "@deepseek-ai/dsh-cua": "workspace:^",
    "@deepseek-ai/dsh-session-turn-outline": "workspace:^",
    "@deepseek-ai/dsh-storage": "workspace:^",
    "@deepseek-ai/dsh-storage-domain": "workspace:^",
    "@deepseek-ai/dsh-token-meter": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cosmokit": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-schedule": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-format": "workspace:^",
    "@deepseek-ai/dsh-session-format-catalog": "workspace:^",
    "@deepseek-ai/dsh-session-persistence": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "@deepseek-ai/dsh-session-projection-cache": "workspace:^",
    "@deepseek-ai/dsh-session-query": "workspace:^",
    "@deepseek-ai/dsh-storage": "workspace:^",
    "@deepseek-ai/dsh-workspace": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.2-rc.2 < 0.2.3"
  }
}
