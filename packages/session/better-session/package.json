{
  "name": "@morlay/better-session",
  "version": "0.0.21-alpha.7",
  "description": "dsh profile bundle: assembles @morlay/session-branch, @morlay/session-rdb, @morlay/ui-conversation-message-actions and the thin-shell fork of the conversation shell (only the files we changed, the rest imported from upstream source) into a DeepSeek Harness web profile — the rewind / retry / recall / fork closed loop on RDB persistence.",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "fork",
    "retry",
    "rewind",
    "session-rdb",
    "ui-conversation-message-actions"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "locale/*.json",
    "dist",
    "src",
    "cordis.patch.yml",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json",
      "./cordis.patch.yml": "./cordis.patch.yml",
      "./locale/*.json": "./locale/*.json"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@morlay/dsh-client-ui-conversation": "workspace:*",
    "@morlay/dsh-client-ui-primitives": "workspace:*",
    "@morlay/dsh-reference": "workspace:*",
    "@morlay/session-branch": "workspace:*",
    "@morlay/session-rdb": "workspace:*",
    "@morlay/ui-conversation-manager": "workspace:*",
    "@morlay/ui-conversation-message-actions": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
