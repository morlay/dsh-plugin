{
  "name": "@morlay/session-branch",
  "version": "0.1.1",
  "description": "Contract layer for branch-based session editing: the provider abstraction (rewind / forkFrom / readBranchPrefix) plus the high-level service over DeepSeek Harness event-sourced sessions.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "fork",
    "retry",
    "rewind",
    "session-branch"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "locale/*.json",
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./invariant": "./src/invariant.ts",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./invariant": "./dist/invariant.mjs",
      "./package.json": "./package.json",
      "./locale/*.json": "./locale/*.json"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-persistence": "workspace:^"
  }
}
