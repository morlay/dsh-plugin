{
  "name": "@morlay/dsh-app-boot",
  "version": "0.2.7",
  "description": "Our own app-boot: assemble a profile (bundle layers + patches) and boot its Cordis tree — replaces the private @deepseek-ai/dsh/profile-boot composition layer while still building on @deepseek-ai/dsh-app-boot.",
  "keywords": [
    "boot",
    "cordis",
    "dsh",
    "dsh-plugin",
    "profile"
  ],
  "license": "MIT",
  "author": "morlay",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-cmdline": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-http-proxy": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^"
  },
  "devDependencies": {
    "@local/devkit": "workspace:*",
    "@local/tsdown-plugin-cordis": "workspace:*",
    "@types/node": "^26.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "engines": {
    "node": ">=24.11.0",
    "dsh": ">= 0.2.1-rc.1 < 0.2.2"
  }
}
