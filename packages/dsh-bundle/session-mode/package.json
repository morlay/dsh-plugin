{
  "name": "@morlay/dsh-session-mode-profile",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "dsh 行入口（bundle 层）：把 @morlay/session-mode 装成 dsh 的 bundle 行。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json",
      "./client": {
        "default": "./dist/client.cjs"
      },
      "./cordis.patch.yml": "./dist/cordis.patch.yml"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm exec devkit build --filter @morlay/dsh-session-mode-profile"
  },
  "dependencies": {
    "@morlay/session-mode": "workspace:^",
    "@morlay/zephyr": "workspace:^",
    "@morlay/zephyr-app": "workspace:^",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@morlay/dsh-session-mode-profile": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-file-drag",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    },
    "bundle": {
      "patch": "./dist/cordis.patch.yml"
    }
  }
}
