{
  "name": "@morlay/dsh-configurable-sandbox-profile",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "dsh 行入口（bundle 层）：把 @morlay/configurable-sandbox 装成 dsh 的 bundle 行。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {},
  "scripts": {
    "prepublishOnly": "pnpm exec devkit build --filter @morlay/dsh-configurable-sandbox-profile"
  },
  "dependencies": {
    "@morlay/configurable-sandbox": "workspace:^",
    "@morlay/zephyr": "workspace:^",
    "@morlay/zephyr-app": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./dist/cordis.patch.yml"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json",
      "./cordis.patch.yml": "./dist/cordis.patch.yml"
    }
  }
}
