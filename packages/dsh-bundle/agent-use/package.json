{
  "name": "@morlay/dsh-agent-use-profile",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "dsh 行入口（bundle 层）：把 @morlay/agent-use 装成 dsh 的 bundle 行。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {},
  "scripts": {
    "prepublishOnly": "pnpm exec devkit build --filter @morlay/dsh-agent-use-profile"
  },
  "dependencies": {
    "@morlay/agent-use": "workspace:^",
    "@morlay/zephyr": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./dist/cordis.patch.yml"
    }
  }
}
