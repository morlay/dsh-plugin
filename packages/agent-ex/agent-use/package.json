{
  "name": "@morlay/agent-use",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "agent 的浏览器/桌面使用能力（MCP 客户端行）：把 agent-browser 与 agent-desktop 接进工具面。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm exec devkit build --filter @morlay/agent-use"
  },
  "dependencies": {
    "@morlay/dsh-agent": "workspace:^",
    "@morlay/zephyr": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  }
}
