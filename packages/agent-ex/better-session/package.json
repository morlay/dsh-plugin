{
  "name": "@morlay/better-session",
  "version": "0.0.1",
  "private": false,
  "description": "会话的 RDB 持久化、分支数据面与就地编辑编排（宿主半）：替换官方 jsonl 落盘，提供 rewind / retry / fork 与编辑 / 撤回的编排面。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./contract": "./src/contract/index.ts",
    "./endpoint": "./src/endpoint/index.ts",
    "./server": "./src/server/index.ts",
    "./ui": "./src/ui/index.ts",
    "./dsh-bundle": "./src/dsh-bundle.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./endpoint": {
        "types": "./dist/endpoint.d.mts",
        "default": "./dist/endpoint.mjs"
      },
      "./server": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "./ui": {
        "types": "./dist/ui.d.mts",
        "default": "./dist/ui.mjs"
      },
      "./dsh-bundle": {
        "types": "./dist/dsh-bundle.d.mts",
        "default": "./dist/dsh-bundle.mjs"
      },
      "./package.json": "./package.json",
      "./client": {
        "default": "./dist/client.cjs"
      },
      "./cordis.patch.yml": "./dist/cordis.patch.yml"
    }
  },
  "dependencies": {
    "@morlay/dsh-agent": "workspace:^",
    "@morlay/dsh-conversation": "workspace:^",
    "@morlay/dsh-session": "workspace:^",
    "@morlay/dsh-session-persistence": "workspace:^",
    "@morlay/dsh-storage": "workspace:^",
    "@morlay/dsh-workspace": "workspace:^",
    "@morlay/zephyr": "workspace:^",
    "@morlay/zephyr-app": "workspace:^",
    "@morlay/zephyr-rdb": "workspace:^",
    "@morlay/zephyr-ui": "workspace:^",
    "fflate": "^0.8.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@morlay/better-session": "workspace:^",
    "@morlay/dsh-agent-loop": "workspace:^",
    "@morlay/dsh-compaction": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.2-rc.3 < 0.2.3"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./dist/cordis.patch.yml"
    }
  }
}
