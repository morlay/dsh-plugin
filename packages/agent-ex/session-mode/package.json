{
  "name": "@morlay/session-mode",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "会话模式、工具说明分组与提示词通道：模式是一份数据、按会话收口；PTC 由运行时事实（工具目录里有 run_code）触发。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./endpoint": "./src/endpoint/index.ts",
    "./server": "./src/server/index.ts",
    "./ui": "./src/ui/index.ts",
    "./package.json": "./package.json",
    "./dsh-bundle": "./src/dsh-bundle.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./endpoint": {
        "types": "./dist/endpoint.d.mts",
        "default": "./dist/endpoint.mjs"
      },
      "./server": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "./ui": {
        "types": "./dist/ui.d.mts",
        "default": "./dist/ui.mjs"
      },
      "./dsh-bundle": {
        "types": "./dist/dsh-bundle.d.mts",
        "default": "./dist/dsh-bundle.mjs"
      },
      "./package.json": "./package.json",
      "./client": {
        "default": "./dist/client.cjs"
      },
      "./cordis.patch.yml": "./dist/cordis.patch.yml"
    }
  },
  "dependencies": {
    "@morlay/dsh-agent": "workspace:^",
    "@morlay/dsh-fs": "workspace:^",
    "@morlay/dsh-ptc": "workspace:^",
    "@morlay/dsh-session": "workspace:^",
    "@morlay/dsh-skill": "workspace:^",
    "@morlay/dsh-storage": "workspace:^",
    "@morlay/zephyr": "workspace:^",
    "@morlay/zephyr-app": "workspace:^",
    "@morlay/zephyr-ui": "workspace:^",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@morlay/better-session": "workspace:^",
    "@morlay/dsh-agent-loop": "workspace:^",
    "@morlay/dsh-compaction": "workspace:^",
    "@morlay/dsh-session-persistence": "workspace:^",
    "@testing-library/react": "^16.3.0",
    "@types/react": "~18.3.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "zod": "^4.6.6"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-file-drag",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    },
    "bundle": {
      "patch": "./dist/cordis.patch.yml"
    }
  }
}
