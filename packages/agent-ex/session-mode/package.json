{
  "name": "@morlay/session-mode",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "会话模式、工具说明分组与提示词通道：模式是一份数据、按会话收口；PTC 由运行时事实（工具目录里有 run_code）触发。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./endpoint": "./src/endpoint/index.ts",
    "./server": "./src/server/index.ts",
    "./ui": "./src/ui/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./endpoint": {
        "types": "./dist/endpoint.d.mts",
        "default": "./dist/endpoint.mjs"
      },
      "./server": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "./ui": {
        "types": "./dist/ui.d.mts",
        "default": "./dist/ui.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm exec devkit build --filter @morlay/session-mode"
  },
  "dependencies": {
    "@morlay/dsh-agent": "workspace:^",
    "@morlay/dsh-fs": "workspace:^",
    "@morlay/dsh-ptc": "workspace:^",
    "@morlay/dsh-session": "workspace:^",
    "@morlay/dsh-skill": "workspace:^",
    "@morlay/dsh-storage": "workspace:^",
    "@morlay/zephyr": "workspace:^",
    "@morlay/zephyr-app": "workspace:^",
    "@morlay/zephyr-ui": "workspace:^",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@morlay/dsh-agent-loop": "workspace:^",
    "@morlay/dsh-compaction": "workspace:^",
    "@morlay/dsh-session-persistence": "workspace:^",
    "@morlay/session-rdb": "workspace:^",
    "@testing-library/react": "^16.3.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "react": "^18.3.1",
    "zod": "^4.6.6"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  }
}
