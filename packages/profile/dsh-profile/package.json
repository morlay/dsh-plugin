{
  "name": "@morlay/dsh-profile",
  "version": "0.0.6-alpha.6",
  "description": "Personal dsh profile: 配置初始化层——只给 llm route、welcome notice、搜索后端选择与沙箱访问规则这类 config 值；行的装配（禁官方行 / 插能力行）归各能力包自己的 bundle。",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "llm-pi-ai",
    "sandbox"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "dist",
    "src",
    "tool",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json",
      "./cordis.patch.yml": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
