{
  "name": "@morlay/dsh-session-mode",
  "version": "0.0.1-alpha.3",
  "description": "Personal dsh bundle: session modes (coding / chat) as data — a mode is a persona plus the tools it may use. The host applies the current mode to each session, and the new-session chip plus the session-header label replace the official agent-preset surface.",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "persona",
    "session-mode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "locale/*.json",
    "dist",
    "src",
    "tool",
    "cordis.patch.yml",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./dist/client.cjs"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./client": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      },
      "./package.json": "./package.json",
      "./cordis.patch.yml": "./cordis.patch.yml",
      "./locale/*.json": "./locale/*.json"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/cordis-plugin-include": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-loop-testkit": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@morlay/dsh-agent-toolkit": "workspace:*",
    "@morlay/dsh-client-ui-conversation": "workspace:*",
    "@morlay/dsh-context-assembler": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "~18.3.1",
    "js-yaml": "^4.1.0",
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:*",
    "@morlay/dsh-client-ui-conversation": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@morlay/dsh-client-ui-conversation"
      ]
    }
  }
}
