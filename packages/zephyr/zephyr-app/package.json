{
  "name": "@morlay/zephyr-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./client": "./src/client/index.ts",
    "./remote": "./src/remote/index.ts",
    "./testing": "./src/testing/index.ts",
    "./client/remote": "./src/client/remote/index.ts",
    "./client/app-boot/boot-page": "./src/client/app-boot/boot-page.ts",
    "./client/base.css": "./src/client/app-boot/base.css"
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-gateway": "workspace:*",
    "@deepseek-ai/dsh-api-remote-access": "workspace:*",
    "@deepseek-ai/dsh-api-remotes": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-api-workspace-controller": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-resources": "workspace:*",
    "@deepseek-ai/dsh-client-shortcuts": "workspace:*",
    "@deepseek-ai/dsh-client-ui-file-drag": "workspace:*",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-session": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-theme": "workspace:*",
    "@deepseek-ai/dsh-client-ui-workspace": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-typert-registry": "workspace:*",
    "@deepseek-ai/dsh-web-app": "workspace:*",
    "@morlay/zephyr": "workspace:*",
    "@oxc-project/runtime": "^0.153.0",
    "lightningcss": "^1.30.0",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@morlay/dsh-session": "workspace:*",
    "@types/node": "^26.5.0",
    "@deepseek-ai/dsh-credentials": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "react": "^18.3.1",
    "rolldown": "^1.2.14"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json",
      "./client": {
        "types": "./dist/client.d.mts",
        "import": "./dist/client.mjs",
        "default": "./dist/client.cjs"
      },
      "./remote": {
        "types": "./dist/remote.d.mts",
        "default": "./dist/remote.mjs"
      },
      "./testing": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      }
    }
  }
}
