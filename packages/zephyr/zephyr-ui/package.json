{
  "name": "@morlay/zephyr-ui",
  "version": "0.0.1",
  "private": true,
  "description": "对话 UI 与设置页共用的基础面：官方基础组件的统一出口、布局原语、控件、按 schema 生成的行配置页，以及 host 与 client 共用的引用解析与渲染。普通库，不是装配行。",
  "keywords": [
    "client",
    "css-modules",
    "design-tokens",
    "ui-kit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/client/index.ts",
    "./reference": "./src/index.ts",
    "./brand-font.css": "./src/styles/brand-font.css",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-theme": "workspace:^",
    "@morlay/zephyr": "workspace:^",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-remotes": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-store": "workspace:^",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@types/mdast": "^4.0.4"
  },
  "engines": {
    "dsh": ">= 0.2.2-rc.2 < 0.2.3"
  }
}
