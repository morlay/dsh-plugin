{
  "name": "@morlay/zephyr-dev",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "zephyr 的开发运行时与构建器：前端动态构建 / HMR、后端换树、联邦预编译与产物落盘；在 @morlay/zephyr-app 的运行时之上扩展。",
  "keywords": [
    "build",
    "dev",
    "dsh",
    "dsh-plugin",
    "vite",
    "zephyr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./node": "./src/node.ts",
    "./testing": "./src/testing/index.ts",
    "./build": "./src/build/zephyr-client-vite.ts",
    "./federation/prebundle": "./src/federation/prebundle.ts",
    "./federation/prebundle-plan": "./src/federation/prebundle-plan.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./node": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "./testing": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "./build": {
        "types": "./dist/build.d.mts",
        "default": "./dist/build.mjs"
      },
      "./federation/prebundle": {
        "types": "./dist/federation/prebundle.d.mts",
        "default": "./dist/federation/prebundle.mjs"
      },
      "./federation/prebundle-plan": {
        "types": "./dist/federation/prebundle-plan.d.mts",
        "default": "./dist/federation/prebundle-plan.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@morlay/zephyr": "workspace:^",
    "@morlay/zephyr-app": "workspace:^",
    "chokidar": "^4.0.3",
    "lightningcss": "^1.30.0",
    "rolldown": "^1.2.14",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  }
}
