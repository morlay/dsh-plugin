{
  "name": "@morlay/zephyr-dev",
  "version": "0.0.1",
  "private": true,
  "description": "zephyr 的开发运行时与构建器：前端动态构建 / HMR、后端换树、联邦预编译与产物落盘；在 @morlay/zephyr-app 的运行时之上扩展。",
  "keywords": [
    "build",
    "dev",
    "dsh",
    "dsh-plugin",
    "vite",
    "zephyr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./node": "./src/node.ts",
    "./testing": "./src/testing/index.ts",
    "./build": "./src/build/zephyr-client-vite.ts",
    "./federation/prebundle": "./src/federation/prebundle.ts",
    "./federation/prebundle-plan": "./src/federation/prebundle-plan.ts"
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@morlay/zephyr": "workspace:^",
    "@morlay/zephyr-app": "workspace:^",
    "chokidar": "^4.0.3",
    "lightningcss": "^1.30.0",
    "rolldown": "^1.2.14",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0"
  }
}
