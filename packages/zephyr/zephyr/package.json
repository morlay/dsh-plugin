{
  "name": "@morlay/zephyr",
  "version": "0.2.0-alpha.0",
  "description": "Typed-safe cordis adapter: class-based DI (@Injectable / inject / EventEmitter) with Context kept internal, plus toCordis() for dsh rows.",
  "keywords": [
    "cordis",
    "dependency-injection",
    "dsh",
    "dsh-plugin",
    "zephyr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./compat": "./src/compat/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./compat": {
        "types": "./dist/compat.d.mts",
        "default": "./dist/compat.mjs"
      },
      "./testing": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm exec devkit build --filter @morlay/zephyr"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "vitest": "5.x"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "vitest": "5.x"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  }
}
