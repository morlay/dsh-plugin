{
  "name": "@morlay/zephyr",
  "version": "0.0.1",
  "description": "Typed-safe cordis adapter: class-based DI (@Injectable / inject / EventEmitter) with Context kept internal, plus toCordis() for dsh rows.",
  "keywords": [
    "cordis",
    "dependency-injection",
    "dsh",
    "dsh-plugin",
    "zephyr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./compat": "./src/compat/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./client": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./compat": {
        "types": "./dist/compat.d.mts",
        "default": "./dist/compat.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.1-rc.1 < 0.2.2"
  }
}
