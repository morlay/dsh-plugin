{
  "name": "@morlay/dsh-fs",
  "version": "0.0.1",
  "private": false,
  "description": "文件系统契约（`FileSystem`）本身，让工具与沙箱共用一个读写面。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./contract": "./src/contract/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./contract": {
        "types": "./dist/contract.d.mts",
        "default": "./dist/contract.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-fs": "workspace:^",
    "@deepseek-ai/dsh-fs-local": "workspace:^",
    "@morlay/zephyr": "workspace:^"
  },
  "devDependencies": {
    "@morlay/zephyr-app": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.2-rc.3 < 0.2.3"
  }
}
