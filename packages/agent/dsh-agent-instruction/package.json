{
  "name": "@morlay/dsh-agent-instruction",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "把仓库里的 agent 指令按字节上限注入系统提示词。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm exec devkit build --filter @morlay/dsh-agent-instruction"
  },
  "dependencies": {
    "@morlay/dsh-session": "workspace:^",
    "@morlay/zephyr": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-fs-local": "workspace:^",
    "@morlay/dsh-agent": "workspace:^",
    "@morlay/dsh-agent-instruction": "workspace:^",
    "@morlay/dsh-fs": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-instructions": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  }
}
