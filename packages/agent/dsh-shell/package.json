{
  "name": "@morlay/dsh-shell",
  "version": "0.0.1",
  "private": false,
  "description": "shell 面：子进程运行时、shell 环境注册表与执行器契约——要起进程的能力都从这里走。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./endpoint": "./src/endpoint/index.ts",
    "./server": "./src/server/index.ts",
    "./package.json": "./package.json",
    "./ui": "./src/ui/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./endpoint": {
        "types": "./dist/endpoint.d.mts",
        "default": "./dist/endpoint.mjs"
      },
      "./server": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "./ui": {
        "types": "./dist/ui.d.mts",
        "default": "./dist/ui.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-terminal-controller": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sidebar-terminal": "workspace:^",
    "@deepseek-ai/dsh-shell": "workspace:^",
    "@deepseek-ai/dsh-shell-env": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@deepseek-ai/dsh-subprocess-local": "workspace:^",
    "@morlay/zephyr": "workspace:^",
    "@morlay/zephyr-app": "workspace:^"
  },
  "devDependencies": {
    "@morlay/zephyr-app": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.2-rc.3 < 0.2.3"
  }
}
