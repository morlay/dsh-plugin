{
  "name": "@morlay/dsh-ptc",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "PTC（programmatic tool calls，程序化工具调用）的运行时：「模型写一段程序、程序里调工具」这条路的执行面。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./contract": "./src/contract/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./contract": {
        "types": "./dist/contract.d.mts",
        "default": "./dist/contract.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm exec devkit build --filter @morlay/dsh-ptc"
  },
  "dependencies": {
    "@morlay/dsh-agent": "workspace:^",
    "@morlay/dsh-fs": "workspace:^",
    "@morlay/dsh-sandbox": "workspace:^",
    "@morlay/dsh-shell": "workspace:^",
    "@morlay/zephyr": "workspace:^"
  },
  "devDependencies": {
    "@morlay/dsh-session": "workspace:^",
    "@morlay/zephyr-app": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-ptc-runtime-node": "workspace:^",
    "@deepseek-ai/dsh-tool-executor-ptc": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  }
}
