{
  "name": "@morlay/dsh-agent",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "agent 的运行时骨架：会话与 agent 的注册表、LLM 调用、系统提示词、工具注册表和 agent loop。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./package.json": "./package.json",
    "./contract": "./src/contract/index.ts",
    "./endpoint": "./src/endpoint/index.ts",
    "./ui": "./src/ui/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./server": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "./contract": {
        "types": "./dist/contract.d.mts",
        "default": "./dist/contract.mjs"
      },
      "./endpoint": {
        "types": "./dist/endpoint.d.mts",
        "default": "./dist/endpoint.mjs"
      },
      "./ui": {
        "types": "./dist/ui.d.mts",
        "default": "./dist/ui.mjs"
      },
      "./testing": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm exec devkit build --filter @morlay/dsh-agent"
  },
  "dependencies": {
    "@morlay/dsh-fs": "workspace:^",
    "@morlay/dsh-session": "workspace:^",
    "@morlay/dsh-setting": "workspace:^",
    "@morlay/zephyr": "workspace:^",
    "@morlay/zephyr-app": "workspace:^"
  },
  "devDependencies": {
    "@morlay/dsh-auth": "workspace:^",
    "@morlay/dsh-session": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-timer": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-agent-default-model": "workspace:^",
    "@deepseek-ai/dsh-agent-preset-registry": "workspace:^",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "workspace:^",
    "@deepseek-ai/dsh-fs-local": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "workspace:^",
    "@deepseek-ai/dsh-llm-pi-ai": "workspace:^",
    "@deepseek-ai/dsh-llm-retry": "workspace:^",
    "@deepseek-ai/dsh-mcp-client": "workspace:^",
    "@deepseek-ai/dsh-mcp-resources": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-subagent": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^",
    "@deepseek-ai/dsh-working-directory": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  }
}
