{
  "name": "@morlay/dsh-web-access",
  "version": "0.0.1",
  "private": false,
  "description": "联网访问：搜索与抓取两个后端、一个 `Web` 契约，以及给模型的 web 工具行。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./server": "./src/server/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./server": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tool-web": "workspace:^",
    "@deepseek-ai/dsh-web": "workspace:^",
    "@deepseek-ai/dsh-web-fetch-http": "workspace:^",
    "@deepseek-ai/dsh-web-search-deepseek": "workspace:^",
    "@morlay/dsh-agent": "workspace:^",
    "@morlay/dsh-auth": "workspace:^",
    "@morlay/zephyr": "workspace:^"
  },
  "devDependencies": {
    "@morlay/dsh-web-access": "workspace:^",
    "@morlay/zephyr-app": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  }
}
