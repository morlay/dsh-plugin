{
  "name": "@morlay/dsh-command",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "命令注册表与斜杠命令的两半：谁能登记一条命令、模型与用户怎么触发它，各有各的面。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract/index.ts",
    "./endpoint": "./src/endpoint/index.ts",
    "./server": "./src/server/index.ts",
    "./ui": "./src/ui/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./contract": {
        "types": "./dist/contract.d.mts",
        "default": "./dist/contract.mjs"
      },
      "./endpoint": {
        "types": "./dist/endpoint.d.mts",
        "default": "./dist/endpoint.mjs"
      },
      "./server": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "./ui": {
        "types": "./dist/ui.d.mts",
        "default": "./dist/ui.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm exec devkit build --filter @morlay/dsh-command"
  },
  "dependencies": {
    "@morlay/dsh-agent": "workspace:^",
    "@morlay/dsh-session": "workspace:^",
    "@morlay/zephyr": "workspace:^",
    "@morlay/zephyr-app": "workspace:^"
  },
  "devDependencies": {
    "@morlay/dsh-agent-loop": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-commands": "workspace:^",
    "@deepseek-ai/dsh-commands": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  }
}
