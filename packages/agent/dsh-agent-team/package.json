{
  "name": "@morlay/dsh-agent-team",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "Agent Teams：接管上游 TeamService（服务名 agentTeams）与它那套团队工具（send_message / list_agents / wait_agent / interrupt_agent / team_task_*），让 Lead 能派发队友、共享任务板并等待结果。派生用上游的 subagent / subagent_fork（spawn_teammate 已在 v0.2.1-rc.2 移除）。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./ui": "./src/ui/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./server": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "./ui": {
        "types": "./dist/ui.d.mts",
        "default": "./dist/ui.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm exec devkit build --filter @morlay/dsh-agent-team"
  },
  "dependencies": {
    "@morlay/dsh-agent": "workspace:^",
    "@morlay/dsh-session": "workspace:^",
    "@morlay/dsh-session-persistence": "workspace:^",
    "@morlay/zephyr": "workspace:^",
    "@morlay/zephyr-app": "workspace:^"
  },
  "devDependencies": {
    "@morlay/dsh-agent": "workspace:^",
    "@morlay/dsh-agent-loop": "workspace:^",
    "@morlay/dsh-sandbox": "workspace:^",
    "@morlay/dsh-session": "workspace:^",
    "@morlay/dsh-session-persistence": "workspace:^",
    "@morlay/dsh-shell": "workspace:^",
    "@morlay/session-mode": "workspace:^",
    "@morlay/zephyr-app": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-team": "workspace:^",
    "@deepseek-ai/dsh-client-ui-agent-team": "workspace:^",
    "@deepseek-ai/dsh-tool-agent-team": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  }
}
