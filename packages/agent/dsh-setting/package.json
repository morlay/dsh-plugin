{
  "name": "@morlay/dsh-setting",
  "version": "0.0.1",
  "private": true,
  "description": "LLM provider 的配置行（pi-ai、DeepSeek API key、API 扩展注册表）与设置面板的浏览器半：装起来就生效。",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./server": "./src/server/index.ts",
    "./endpoint": "./src/endpoint/index.ts"
  },
