    "@morlay/dsh-sandbox": "workspace:*",
    "@morlay/dsh-session-persistence": "workspace:*",
    "@morlay/dsh-setting": "workspace:*",
    "@morlay/dsh-shell": "workspace:*",
    "@morlay/dsh-skill": "workspace:*",
    "@morlay/dsh-storage": "workspace:*",
    "@morlay/dsh-upload": "workspace:*",
    "@morlay/dsh-working-directory": "workspace:*",
    "@morlay/dsh-workspace": "workspace:*"
  },
  "engines": {
    "dsh": ">= 0.2.1-rc.1 < 0.2.2"
  },
  "publishConfig": {
    "exports": {
      "./server": "./src/server/index.ts"
    }
