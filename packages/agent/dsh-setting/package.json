{
  "name": "@morlay/dsh-setting",
  "version": "0.0.1",
  "description": "LLM provider 的配置行（pi-ai、DeepSeek API key、API 扩展注册表）与设置面板的浏览器半：装起来就生效。",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./ui": "./src/ui/index.ts",
    "./server": "./src/server/index.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-settings-controller": "workspace:*",
    "@deepseek-ai/dsh-client-ui-model-selection": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-general": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-models": "workspace:*",
    "@deepseek-ai/dsh-client-ui-theme": "workspace:*",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "workspace:*",
    "@deepseek-ai/dsh-llm-pi-ai": "workspace:*",
    "@morlay/dsh-agent": "workspace:*",
    "@morlay/dsh-session": "workspace:*",
    "@morlay/zephyr": "workspace:*",
    "@morlay/zephyr-app": "workspace:*"
  },
  "devDependencies": {
    "@morlay/dsh-attachment": "workspace:*",
