{
  "name": "@morlay/dsh-auth",
  "version": "0.0.1",
  "private": false,
  "description": "只有 API Key 的凭证与授权两行：给 LLM 与工具调用一个可判定的凭据来源，不接平台账号。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./endpoint": "./src/endpoint/index.ts",
    "./package.json": "./package.json",
    "./server": "./src/server/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./endpoint": {
        "types": "./dist/endpoint.d.mts",
        "default": "./dist/endpoint.mjs"
      },
      "./server": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-authorization": "workspace:^",
    "@deepseek-ai/dsh-credentials": "workspace:^",
    "@deepseek-ai/dsh-credentials-local": "workspace:^",
    "@morlay/zephyr": "workspace:^",
    "@morlay/zephyr-app": "workspace:^"
  },
  "devDependencies": {},
  "engines": {
    "dsh": ">= 0.2.2-rc.3 < 0.2.3"
  }
}
