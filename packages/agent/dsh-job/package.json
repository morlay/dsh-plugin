{
  "name": "@morlay/dsh-job",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "后台任务注册表：长跑动作在此登记、查询与取消，工具调用之外也有统一出口。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./endpoint": "./src/endpoint/index.ts",
    "./server": "./src/server/index.ts",
    "./ui": "./src/ui/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./endpoint": {
        "types": "./dist/endpoint.d.mts",
        "default": "./dist/endpoint.mjs"
      },
      "./server": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "./ui": {
        "types": "./dist/ui.d.mts",
        "default": "./dist/ui.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm exec devkit build --filter @morlay/dsh-job"
  },
  "dependencies": {
    "@morlay/dsh-agent": "workspace:^",
    "@morlay/zephyr": "workspace:^",
    "@morlay/zephyr-app": "workspace:^"
  },
  "devDependencies": {
    "@morlay/dsh-job": "workspace:^",
    "@morlay/dsh-session": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-job-controller": "workspace:^",
    "@deepseek-ai/dsh-client-ui-jobs": "workspace:^",
    "@deepseek-ai/dsh-jobs": "workspace:^",
    "@deepseek-ai/dsh-jobs-local": "workspace:^",
    "@deepseek-ai/dsh-tool-jobs": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  }
}
