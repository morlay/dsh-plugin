{
  "name": "@morlay/dsh-conversation",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "对话域（BFF）：会话界面（ui 面）+ 端点聚合（会话端点 / 会话引用 / 文件引用 / 日程）。只依赖 dsh-* 能力包与 zephyr*。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract/index.ts",
    "./endpoint": "./src/endpoint/index.ts",
    "./package.json": "./package.json",
    "./server": "./src/server/index.ts",
    "./ui": "./src/ui/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./contract": {
        "types": "./dist/contract.d.mts",
        "default": "./dist/contract.mjs"
      },
      "./endpoint": {
        "types": "./dist/endpoint.d.mts",
        "default": "./dist/endpoint.mjs"
      },
      "./server": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "./ui": {
        "types": "./dist/ui.d.mts",
        "default": "./dist/ui.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm exec devkit build --filter @morlay/dsh-conversation"
  },
  "dependencies": {
    "@morlay/dsh-agent": "workspace:^",
    "@morlay/dsh-attachment": "workspace:^",
    "@morlay/dsh-fs": "workspace:^",
    "@morlay/dsh-permission": "workspace:^",
    "@morlay/dsh-sandbox": "workspace:^",
    "@morlay/dsh-session": "workspace:^",
    "@morlay/dsh-setting": "workspace:^",
    "@morlay/dsh-upload": "workspace:^",
    "@morlay/dsh-workspace": "workspace:^",
    "@morlay/zephyr": "workspace:^",
    "@morlay/zephyr-app": "workspace:^",
    "@testing-library/react": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-session-panel": "workspace:^",
    "@deepseek-ai/dsh-client-ui-session-status": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sidebar-browser": "workspace:^",
    "@deepseek-ai/dsh-client-ui-workspace": "workspace:^",
    "@deepseek-ai/dsh-tool-testkit": "workspace:^",
    "@morlay/dsh-agent": "workspace:^",
    "@morlay/dsh-agent-loop": "workspace:^",
    "@morlay/dsh-auth": "workspace:^",
    "@morlay/dsh-command": "workspace:^",
    "@morlay/dsh-permission": "workspace:^",
    "@morlay/dsh-sandbox": "workspace:^",
    "@morlay/dsh-session-persistence": "workspace:^",
    "@morlay/dsh-shell": "workspace:^",
    "@morlay/dsh-storage": "workspace:^",
    "@morlay/dsh-upload": "workspace:^",
    "@morlay/dsh-workspace": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-gateway": "workspace:^",
    "@deepseek-ai/dsh-api-session-controller": "workspace:^",
    "@deepseek-ai/dsh-api-settings-controller": "*",
    "@deepseek-ai/dsh-client-ui-approval": "*",
    "@deepseek-ai/dsh-client-ui-attachment": "workspace:^",
    "@deepseek-ai/dsh-client-ui-chat": "workspace:^",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:^",
    "@deepseek-ai/dsh-client-ui-deliverables": "*",
    "@deepseek-ai/dsh-client-ui-file-actions": "workspace:^",
    "@deepseek-ai/dsh-client-ui-input-trigger": "workspace:^",
    "@deepseek-ai/dsh-client-ui-model-selection": "*",
    "@deepseek-ai/dsh-client-ui-open-in-app": "workspace:^",
    "@deepseek-ai/dsh-client-ui-permission-presets": "*",
    "@deepseek-ai/dsh-client-ui-reference": "workspace:^",
    "@deepseek-ai/dsh-client-ui-secret-mask": "workspace:^",
    "@deepseek-ai/dsh-client-ui-session": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-settings-general": "*",
    "@deepseek-ai/dsh-client-ui-settings-models": "*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "workspace:^",
    "@deepseek-ai/dsh-client-ui-subagent": "workspace:^",
    "@deepseek-ai/dsh-client-ui-theme": "*",
    "@deepseek-ai/dsh-client-ui-tool": "workspace:^",
    "@deepseek-ai/dsh-client-ui-trajectory": "workspace:^",
    "@deepseek-ai/dsh-client-ui-user-questions": "*",
    "@deepseek-ai/dsh-client-ui-workflow-run": "workspace:^",
    "@deepseek-ai/dsh-file-reference-local": "workspace:^",
    "@deepseek-ai/dsh-host-open-in-app": "workspace:^",
    "@deepseek-ai/dsh-message-quotes": "workspace:^",
    "@deepseek-ai/dsh-session-reference": "workspace:^",
    "@deepseek-ai/dsh-session-title": "*",
    "@deepseek-ai/dsh-session-title-first-prompt-llm": "*",
    "@deepseek-ai/dsh-subagent": "workspace:^",
    "@deepseek-ai/dsh-workspace-changes": "*"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  }
}
