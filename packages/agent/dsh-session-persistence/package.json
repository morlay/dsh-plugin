    "dsh": ">= 0.2.1-rc.1 < 0.2.2"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-persistence": "workspace:*",
    "@morlay/dsh-session": "workspace:*",
    "@morlay/zephyr": "workspace:*"
  },
  "devDependencies": {
    "@morlay/dsh-session-persistence": "workspace:*",
    "@morlay/zephyr-app": "workspace:*"
  }
}
