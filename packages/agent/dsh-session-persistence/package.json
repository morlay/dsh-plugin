{
  "name": "@morlay/dsh-session-persistence",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "会话落盘：自己实现持久化（不转发上游插件），让会话在进程之外可恢复。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./contract": "./src/contract/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./contract": {
        "types": "./dist/contract.d.mts",
        "default": "./dist/contract.mjs"
      },
      "./testing": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm exec devkit build --filter @morlay/dsh-session-persistence"
  },
  "dependencies": {
    "@morlay/dsh-session": "workspace:^",
    "@morlay/zephyr": "workspace:^"
  },
  "devDependencies": {
    "@morlay/zephyr-app": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session-persistence": "workspace:^",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  }
}
