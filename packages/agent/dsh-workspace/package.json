{
  "name": "@morlay/dsh-workspace",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "工作区与会话的绑定：注册表、目录选择、变更广播，外加浏览器侧的工作区面。",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/index.ts",
    "./contract": "./src/contract/index.ts",
    "./testing": "./src/testing/index.ts",
    "./endpoint": "./src/endpoint/index.ts",
    "./package.json": "./package.json",
    "./server": "./src/server/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./ui": {
        "types": "./dist/ui.d.mts",
        "default": "./dist/ui.mjs"
      },
      "./contract": {
        "types": "./dist/contract.d.mts",
        "default": "./dist/contract.mjs"
      },
      "./testing": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "./endpoint": {
        "types": "./dist/endpoint.d.mts",
        "default": "./dist/endpoint.mjs"
      },
      "./server": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm exec devkit build --filter @morlay/dsh-workspace"
  },
  "dependencies": {
    "@morlay/dsh-fs": "workspace:^",
    "@morlay/dsh-sandbox": "workspace:^",
    "@morlay/dsh-session": "workspace:^",
    "@morlay/dsh-session-persistence": "workspace:^",
    "@morlay/dsh-storage": "workspace:^",
    "@morlay/zephyr": "workspace:^",
    "@morlay/zephyr-app": "workspace:^"
  },
  "devDependencies": {
    "@morlay/zephyr-app": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-workspace-controller": "workspace:^",
    "@deepseek-ai/dsh-api-workspace-files": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sidebar-files": "workspace:^",
    "@deepseek-ai/dsh-host-directory-picker": "workspace:^",
    "@deepseek-ai/dsh-host-directory-picker-native": "workspace:^",
    "@deepseek-ai/dsh-workspace": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.3-alpha.2 < 0.2.4"
  }
}
