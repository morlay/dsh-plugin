{
  "name": "@morlay/session-mode-profile",
  "version": "0.0.1",
  "description": "会话模式与注入面：会话模式行 + 注入通道 + 工具说明（汉化）+ subagent 服务接管行，一次装齐。",
  "icon": "./icon.svg",
  "keywords": [
    "bundle-entry",
    "dsh",
    "dsh-bundle"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "locale/*.json",
    "dist",
    "icon.svg",
    "src",
    "cordis.patch.yml",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json",
      "./cordis.patch.yml": "./cordis.patch.yml",
      "./locale/*.json": "./locale/*.json"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@morlay/dsh-agent-toolkit": "workspace:*",
    "@morlay/dsh-client-ui-primitives": "workspace:*",
    "@morlay/dsh-context-assembler": "workspace:*",
    "@morlay/dsh-session-mode": "workspace:*",
    "@morlay/dsh-subagent": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:*",
    "@local/devkit": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
