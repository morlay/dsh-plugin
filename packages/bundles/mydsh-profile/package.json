{
  "name": "@morlay/mydsh-profile",
  "version": "0.0.13-alpha.0",
  "description": "我的 dsh 个人配置项：界面语言、欢迎提示版本、默认模型与对话视图，外加统一声明的四份 agent preset（复制上游，删掉与 agent-team 冲突的子代理工具行）。",
  "keywords": [
    "bundle-entry",
    "dsh",
    "dsh-bundle",
    "dsh-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "locale/*.json",
    "docs",
    "dist",
    "icon.svg",
    "src",
    "cordis.patch.yml",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json",
      "./cordis.patch.yml": "./cordis.patch.yml",
      "./locale/*.json": "./locale/*.json"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@local/devkit": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "icon": "./icon.svg",
  "engines": {
    "dsh": ">= 0.2.2-alpha.2 < 0.2.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
