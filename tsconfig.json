{
  "compilerOptions": {
    // —— 仓库统一的 TS 口径（只此一份；各包不再各带 base config）——
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "composite": true,
    // 与 `composite` 一起开（上游 `tsconfig.base.json` 同样是两项并写）：`tsc -b` 的增量缓存在各 config
    // 旁那份 `*.tsbuildinfo` 里（gitignore），references 的叶才谈得上「只重编变了的」。
    "incremental": true,
    "sourceMap": false,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "experimentalDecorators": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": false,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "target/dts"
  },
  // `**/*` 默认不进点目录：技能自带的执行器（`.agents/skills/**`）要显式加进来，否则它们没有类型面。
  "include": ["**/*", ".agents/skills/**/*.ts"],
  // `**/target/**`：产物目录（`zephyr build` 的 `<outputDir>`，含 `pnpm deploy` 的闭包与源码面副本）。
  // 只写 `target/**` 会漏掉 `apps/*/target/`——那里的 `.ts` 一旦进 program，类型检查与 tsgolint 都会被
  // 几百份第三方源码拖垮（症状是 `Expected file … to be in program` 之类的 panic）。
  "exclude": ["**/node_modules/**", "**/dist/*", "**/target/**"]
}
