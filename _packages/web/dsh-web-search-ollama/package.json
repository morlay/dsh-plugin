{
  "name": "@morlay/dsh-web-search-ollama",
  "version": "0.0.11",
  "description": "Ollama-backed search provider for the DeepSeek Harness web seam (ctx.web): one web_search backend calling POST https://ollama.com/api/web_search.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ollama",
    "web-search"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "locale/*.json",
    "dist",
    "src",
    "!**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cordis-register": "./src/cordis-register.ts",
    "./package.json": "./package.json",
    "./client": "./src/client/index.ts",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./cordis-register": {
        "types": "./dist/cordis-register.d.mts",
        "default": "./dist/cordis-register.mjs"
      },
      "./package.json": "./package.json",
      "./client": {
        "types": "./dist/client.d.mts",
        "import": "./dist/client.mjs",
        "default": "./dist/client.cjs"
      },
      "./locale/*.json": "./locale/*.json"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "@morlay/zephyr": "workspace:*",
    "@morlay/dsh-base": "workspace:*",
    "@morlay/dsh-web-app": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cosmokit": "workspace:^"
  },
  "engines": {
    "dsh": ">= 0.2.1-rc.1 < 0.2.2"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
